          {
            "slot": "s146",
            "repere": "Intertitre · 2. Make Staying Bald a Whole Lot Easie…",
            "text": "2. Make Staying Bald a Whole Lot Easier",
            "image": "",
            "link": ""
          },
          {
            "slot": "s149",
            "repere": "Paragraphe · Shaving your head once isn’t the hard …",
            "text": "Shaving your head once isn’t the hard part - it’s having to do it again every few days when the stubble comes back. Freebird makes regular maintenance faster and simpler, with less prep, less mess, and an easier routine to actually keep up with.",
            "image": "",
            "link": ""
          },
          {
            "slot": "i152",
            "repere": "Image 530×410",
            "text": "",
            "image": "/imports/freebird-offre/images/07.png",
            "link": ""
          },
          {
            "slot": "s154",
            "repere": "Intertitre · 3. Built for Real Heads - Not Just Per…",
            "text": "3. Built for Real Heads - Not Just Perfect One-Day Stubble",
            "image": "",
            "link": ""
          },
          {
            "slot": "s157",
            "repere": "Paragraphe · Your scalp has curves, your hair grows…",
            "text": "Your scalp has curves, your hair grows in different directions, and sometimes you wait a few days between shaves. Freebird is designed to work around <span style=\"font-weight:700\">the crown, sides, and back of your head</span> - and if your hair gets too long, you can trim it down first and then finish close.",
            "image": "",
            "link": ""
          },
          {
            "slot": "s158",
