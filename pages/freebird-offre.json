          {
            "slot": "s137",
            "repere": "Intertitre · 1. Get the Smooth, Clean-Bald Look You…",
            "text": "1. Get the Smooth, Clean-Bald Look You Actually Want",
            "image": "",
            "link": ""
          },
          {
            "slot": "s140",
            "repere": "Paragraphe · You shave your head because you want i…",
            "text": "You shave your head because you want it to look clean, even, and fully shaved - not patchy or covered in obvious shadow. Freebird is designed to cut short hair close to the scalp so you can <span style=\"font-weight:700\">keep that smooth, freshly shaved look with an easier everyday routine.</span>",
            "image": "",
            "link": ""
          },
          {
