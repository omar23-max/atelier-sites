    {
      "type": "adv-derila-p8",
      "props": {
        "id": "adv-derila-p8",
        "blocks_element": [
          {
            "slot": "s44",
            "repere": "Paragraphe · Claire remembers the accident vividly. S",
            "text": "Claire remembers the accident vividly. She reiterates how grateful she is to have walked away from the wreck, but she says she didn't go alone.",
            "image": "",
            "link": ""
          }
        ]
      }
    },
    {
      "type": "adv-derila-p9",
      "props": {
        "id": "adv-derila-p9",
        "blocks_element": [
          {
            "slot": "s45",
            "repere": "Paragraphe · \"I started off the day just fine. Happy-",
            "text": "\"I started off the day just fine. Happy-go-lucky, care-free, whatever. Now, after the accident, I carry this pain with me. Chronic pain for years. I cannot sleep. It makes me,\" Claire sighs, \"...it is the most difficult thing in my life. No sleep, more pills, more pain. No relief.\"",
            "image": "",
            "link": ""
          }
        ]
      }
    },
