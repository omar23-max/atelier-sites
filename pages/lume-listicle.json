            "image": "",
            "link": ""
          },
          {
            "slot": "s129",
            "repere": "Paragraphe · Lume Whole Body Deodorant works by lower",
            "text": "Lume Whole Body Deodorant works by lowering the skin's pH using Mandelic Acid, a gentle AHA. This blocks the process where bacteria on the skin consume fluids like sweat and produce odor. The low pH formula also helps keep skin happy by supporting the protective acid mantle.",
            "image": "",
            "link": ""
          },
          {
            "slot": "s131",
            "repere": "Texte · Where and how do I apply Lume deodorant?",
            "text": "Where and how do I apply Lume deodorant?",
            "image": "",
            "link": ""
          },
          {
            "slot": "s132",
            "repere": "Paragraphe · Our Whole Body deodorants can be used an",
            "text": "Our Whole Body deodorants can be used anywhere externally you might have odor: underarms, intimate areas, feet, underboobs, belly buttons and tummy folds. For best results, apply to dry skin.",
            "image": "",
            "link": ""
          },
          {
            "slot": "s134",
            "repere": "Texte · Are Lume products skin-safe, vegan, crue",
            "text": "Are Lume products skin-safe, vegan, cruelty-free, etc?",
            "image": "",
            "link": ""
          },
          {
            "slot": "s135",
            "repere": "Paragraphe · Yes, our Whole Body deodorants are formu",
            "text": "Yes, our Whole Body deodorants are formulated with skin safety in mind and extensively tested. They are vegan and cruelty-free and formulated without baking soda, dyes, parabens, or phthalates.",
            "image": "",
            "link": ""
          }
        ]
