      "props": {
        "id": "replo-jeni-s-offre-p5",
        "blocks_element": [
          {
            "slot": "s318",
            "repere": "Paragraphe · Good is what you say when you actually…",
            "text": "Good is what you say when you actually mean \"fine,\" \"decent,\" \"ok,\" \"not bad,\" \"pretty alright.\" This isn't about being polite, this is about pleasure. Our ice cream is a full stop. A spoon-drop. A why-doesn't-everything-taste-like-this moment. Scoop it, lick it, curse it, love it, hate it—whatever. Just don't call it good.",
            "image": "",
            "link": ""
          }
        ]
      }
    },
