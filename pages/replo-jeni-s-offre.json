          {
            "slot": "s335",
            "repere": "Paragraphe · ALL KILLER, NO FILLER",
            "text": "ALL KILLER, NO FILLER",
            "image": "",
            "link": ""
          },
          {
            "slot": "s336",
            "repere": "Intertitre · Melts perfectly with a clean, lingerin…",
            "text": "Melts perfectly with a clean, lingering finish",
            "image": "",
            "link": ""
          },
          {
            "slot": "s337",
            "repere": "Paragraphe · Our recipe is the perfect blank canvas…",
            "text": "Our recipe is the perfect blank canvas for the purest expression of flavor — it has everything it needs and nothing it doesn't.<br><br>No cheap ingredients.<br>No flavorings.<br>No artificial dyes.<br>No fake stuff.<br>No cutting corners.<br>No shortcuts.<br>No bullsh#t. <span style=\"font-style:italic\"><br><br></span>Nothing hides in ice cream. If you cut corners on ingredients, it shows.",
            "image": "",
            "link": ""
          },
          {
            "slot": "i341",
            "repere": "Image 720×1080",
            "text": "",
            "image": "/imports/replo-jeni-s-offre/images/09.png",
            "link": ""
          }
        ]
      }
    },
    {
      "type": "replo-jeni-s-offre-p8",
      "props": {
        "id": "replo-jeni-s-offre-p8",
        "blocks_element": [
          {
            "slot": "s346",
            "repere": "Paragraphe · FLAVOR IS EVERYTHING",
            "text": "FLAVOR IS EVERYTHING",
            "image": "",
            "link": ""
          },
          {
            "slot": "s347",
            "repere": "Intertitre · We make flavors we fall madly in love …",
            "text": "We make flavors we fall madly in love with",
            "image": "",
            "link": ""
          },
          {
            "slot": "s348",
            "repere": "Paragraphe · Elevated takes on classic flavors rein…",
            "text": "Elevated takes on classic flavors reinterpreted through our POV. And unexpected flavors inspired by the world around us that only we can make. No gimmicks or stunts. And nothing less than splendid. Just ice creams we fall madly in love with and want to share with the world.",
            "image": "",
            "link": ""
          },
          {
            "slot": "i352",
            "repere": "Image 720×899.52",
            "text": "",
