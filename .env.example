# Copie ce fichier en « .env.local » (même dossier) et remplis les 2 valeurs.
# .env.local n'est JAMAIS envoyé sur GitHub (voir .gitignore).
#
# Supabase → ton projet → Project Settings → API :
#   - Project URL
#   - service_role (secret) — clé complète, à ne jamais partager
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
