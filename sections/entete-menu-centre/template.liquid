<div
  class="atl-entete-menu-centre"
  style="--atl-bg: {{ section.settings.color_bg }}; --atl-text: {{ section.settings.color_text }}; --atl-logo-w: {{ section.settings.logo_width }}px;"
>
  <div class="atl-entete-menu-centre__inner">
    <details class="atl-entete-menu-centre__burger">
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2"/></svg>
      </summary>
      <nav class="atl-entete-menu-centre__drawer">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </nav>
    </details>

    <a class="atl-entete-menu-centre__logo" href="{{ section.settings.home_link | default: '/' }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 500 }}" alt="{{ section.settings.logo_text | escape }}">
      {%- else -%}
        <span>{{ section.settings.logo_text }}</span>
      {%- endif -%}
    </a>

    <nav class="atl-entete-menu-centre__nav">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </nav>

    <div class="atl-entete-menu-centre__icons">
      {%- if section.settings.show_currency -%}
        <span class="atl-entete-menu-centre__currency">
          <span class="atl-entete-menu-centre__flag" aria-hidden="true"></span>
          {{ section.settings.currency_label }}
          <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
        </span>
      {%- endif -%}
      <a class="atl-entete-menu-centre__cart" href="{{ section.settings.cart_link | default: '/cart' }}" aria-label="Panier">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8zm4 0V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </a>
    </div>
  </div>
</div>
