          "default": "paragraphe"
        },
        { "type": "textarea", "id": "text", "label": "Texte (liste : un point par ligne ; image : légende)", "default": "[ Paragraphe — 40-60 mots ]" },
        { "type": "image_picker", "id": "image", "label": "Image (type Image ou Auteur)" },
        { "type": "range", "id": "image_width", "label": "Largeur de l'image", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 },
        { "type": "url", "id": "link", "label": "Lien (type Bouton)" },
        {
          "type": "select",
          "id": "align",
          "label": "Alignement",
          "options": [
            { "value": "left", "label": "Gauche" },
            { "value": "center", "label": "Centre" },
            { "value": "right", "label": "Droite" }
          ],
          "default": "left"
        },
        { "type": "range", "id": "size", "label": "Taille du texte (0 = taille de la section)", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0 },
        { "type": "checkbox", "id": "bold", "label": "Gras", "default": false },
        { "type": "checkbox", "id": "italic", "label": "Italique", "default": false },
        { "type": "color", "id": "color", "label": "Couleur du texte (vide = couleur de la section)" },
        { "type": "color", "id": "bg", "label": "Fond (vide = aucun)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atl · Advertorial (article)",
      "blocks": [
        { "type": "element", "settings": { "repere": "Sur-titre", "kind": "surtitre", "text": "[ Rubrique — 1-2 mots ]" } },
        { "type": "element", "settings": { "repere": "Grand titre", "kind": "titre", "text": "[ Titre accrocheur de l'article — 10-14 mots ]" } },
        { "type": "element", "settings": { "repere": "Auteur", "kind": "auteur", "text": "[ Par Prénom Nom ] · [ date ]" } },
        { "type": "element", "settings": { "repere": "Image", "kind": "image", "text": "" } },
        { "type": "element", "settings": { "repere": "Paragraphe", "kind": "paragraphe", "text": "[ Accroche : le problème du lecteur — 40-60 mots ]" } },
        { "type": "element", "settings": { "repere": "Intertitre", "kind": "intertitre", "text": "[ Intertitre — 6-9 mots ]" } },
        { "type": "element", "settings": { "repere": "Paragraphe", "kind": "paragraphe", "text": "[ Paragraphe — 40-60 mots ]" } },
        { "type": "element", "settings": { "repere": "Bouton", "kind": "bouton", "text": "[ Bouton — 3-5 mots ]", "align": "center" } }
      ]
    }
  ]
