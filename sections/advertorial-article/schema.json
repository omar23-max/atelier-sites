    { "type": "range", "id": "padding_y", "label": "Marge haut et bas", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "font_size", "label": "Taille du texte", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "title_size", "label": "Taille du grand titre", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "subtitle_size", "label": "Taille des intertitres", "min": 18, "max": 44, "step": 1, "unit": "px", "default": 26 },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "color_bg", "label": "Fond", "default": "#ffffff" },
    { "type": "color", "id": "color_text", "label": "Texte", "default": "#222222" },
    { "type": "color", "id": "color_heading", "label": "Titres", "default": "#111111" },
    { "type": "color", "id": "color_link", "label": "Liens", "default": "#0b57d0" },
    { "type": "color", "id": "color_button", "label": "Boutons", "default": "#e4572e" },
    { "type": "color", "id": "color_button_text", "label": "Texte des boutons", "default": "#ffffff" },
    { "type": "color", "id": "color_box", "label": "Fond des encadrés", "default": "#f4f4f4" }
  ],
  "blocks": [
    {
      "type": "element",
      "name": "Élément",
      "settings": [
        { "type": "text", "id": "repere", "label": "Repère (nom dans la liste)", "default": "Paragraphe" },
        {
          "type": "select",
          "id": "kind",
          "label": "Type",
          "options": [
            { "value": "surtitre", "label": "Sur-titre" },
            { "value": "titre", "label": "Grand titre" },
            { "value": "intertitre", "label": "Intertitre" },
            { "value": "paragraphe", "label": "Paragraphe" },
            { "value": "image", "label": "Image" },
            { "value": "liste", "label": "Liste" },
            { "value": "citation", "label": "Citation" },
            { "value": "encadre", "label": "Encadré" },
            { "value": "bouton", "label": "Bouton" },
            { "value": "auteur", "label": "Auteur et date" },
            { "value": "separateur", "label": "Séparateur" }
