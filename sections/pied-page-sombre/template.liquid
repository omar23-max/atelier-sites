<footer
  class="atl-pied-page-sombre"
  style="--atl-bg: {{ section.settings.color_bg }}; --atl-bg-2: {{ section.settings.color_bg_2 }};{% if section.settings.bg_image != blank %} --atl-bg-img: url('{{ section.settings.bg_image | image_url: width: 2400 }}');{% endif %}"
>
  <div class="atl-pied-page-sombre__inner">
    <div class="atl-pied-page-sombre__top">
      <div class="atl-pied-page-sombre__brand">
        {%- if section.settings.logo != blank -%}
          <img class="atl-pied-page-sombre__logo" src="{{ section.settings.logo | image_url: width: 500 }}" alt="{{ section.settings.logo_text | escape }}">
        {%- else -%}
          <span class="atl-pied-page-sombre__logo-text">♡ {{ section.settings.logo_text }}</span>
        {%- endif -%}
        {%- assign infos = section.settings.infos | newline_to_br | split: '<br />' -%}
        {%- for line in infos -%}
          {%- assign parts = line | split: ' : ' -%}
          {%- assign label = parts[0] | strip -%}
          {%- if label != blank -%}
            <p>{% if parts.size > 1 %}<strong>{{ label }} :</strong> {{ parts[1] | strip }}{% else %}{{ label }}{% endif %}</p>
          {%- endif -%}
        {%- endfor -%}
        <div class="atl-pied-page-sombre__social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></a>
          {%- endif -%}
          {%- if section.settings.facebook != blank -%}
            <a href="{{ section.settings.facebook }}" aria-label="Facebook"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v7h4v-7h3l1-4h-4V8z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'colonne' -%}
          <div class="atl-pied-page-sombre__col" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.title }}</h2>
            <ul>
              {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign parts = line | split: '|' -%}
                {%- assign label = parts[0] | strip -%}
                {%- if label != blank -%}
                  <li><a href="{{ parts[1] | strip | default: '#' }}">{{ label }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="atl-pied-page-sombre__legal">{{ section.settings.disclaimer | newline_to_br }}</div>
    </div>

    <div class="atl-pied-page-sombre__bottom">
      <p>{{ section.settings.copyright }}</p>
      {%- if section.settings.show_payment_icons -%}
        <div class="atl-pied-page-sombre__payments">
          {%- if shop.enabled_payment_types.size > 0 -%}
            {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'atl-pied-page-sombre__pay' }}{%- endfor -%}
          {%- else -%}
            <span class="atl-pied-page-sombre__pay">VISA</span><span class="atl-pied-page-sombre__pay">MC</span><span class="atl-pied-page-sombre__pay">PayPal</span><span class="atl-pied-page-sombre__pay">Apple Pay</span><span class="atl-pied-page-sombre__pay">G Pay</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>
