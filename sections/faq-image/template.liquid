<section class="atl-faq-image" style="--atl-bg: {{ section.settings.color_bg }}; --atl-text: {{ section.settings.color_text }}; --atl-accent: {{ section.settings.color_accent }};">
  <div class="atl-faq-image__inner">
    <div class="atl-faq-image__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="" loading="lazy">
      {%- else -%}
        <span>[ Photo du produit en situation ]</span>
      {%- endif -%}
    </div>
    <div>
      <p class="atl-faq-image__kicker">{{ section.settings.kicker }}</p>
      <h2 class="atl-faq-image__title">{{ section.settings.title }}</h2>
      <div class="atl-faq-image__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' -%}
            <details class="atl-faq-image__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <p>{{ block.settings.answer | newline_to_br }}</p>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
