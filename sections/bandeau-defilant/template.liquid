{%- assign items = section.settings.items | newline_to_br | split: '<br />' -%}
<div class="atl-bandeau-defilant" style="--atl-bg: {{ section.settings.color_bg }}; --atl-text: {{ section.settings.color_text }}; --atl-accent: {{ section.settings.color_accent }}; --atl-speed: {{ section.settings.speed }}s;">
  <div class="atl-bandeau-defilant__track">
    {%- for copy in (1..2) -%}
      <ul class="atl-bandeau-defilant__list" {% if copy == 2 %}aria-hidden="true"{% endif %}>
        {%- for line in items -%}
          {%- assign t = line | strip -%}
          {%- if t != blank -%}
            <li>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="3"/></svg>
              {{ t }}
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- for line in items -%}
          {%- assign t = line | strip -%}
          {%- if t != blank -%}
            <li>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="3"/></svg>
              {{ t }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>
