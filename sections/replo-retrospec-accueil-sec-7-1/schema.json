    },
    {
      "type": "text",
      "id": "marge_bas",
      "label": "Marge en bas, px (vide = d'origine)"
    },
    {
      "type": "select",
      "id": "largeur",
      "label": "Largeur du contenu",
      "options": [
        {
          "value": "",
          "label": "D'origine"
        },
        {
          "value": "large",
          "label": "Large (1200 px)"
        },
        {
          "value": "etroite",
          "label": "Étroite (760 px)"
        }
      ],
      "default": ""
