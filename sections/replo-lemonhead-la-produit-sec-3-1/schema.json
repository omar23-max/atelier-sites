        },
        {
          "type": "element",
          "settings": {
            "slot": "s1101",
            "repere": "Paragraphe · Pro Jar: Net Wt. 18g, 15mL/0.6 fl oz M…",
            "text": "Pro Jar: Net Wt. 18g, 15mL/0.6 fl oz<br>Mini Jar: Net Wt. 8g, 5mL/0.2 fl oz",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1102",
            "repere": "Paragraphe · Shelf life: Your Spacepaste® will reta…",
            "text": "Shelf life: Your Spacepaste® will retain its signature texture for approximately 18-24 months depending on usage/environmental exposure. To maintain the high quality of your LHLA products, we recommend watching this video. Revive old product or mix your own with distilled water + LEMON.AID Mixing Medium.",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1103",
            "repere": "Paragraphe · • Made in LA by Artists, for Artists •…",
            "text": "• Made in LA by Artists, for Artists<br>• Certified Vegan + Cruelty-Free (Peta)<br>• Leaping Bunny Certified<br>• Awards: PETA Beauty Awards: Best Vegan Accessory; Best Glitter Makeup 2018-2023 (Who What Wear)",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "t1108_1",
            "repere": "Texte · glitter care",
            "text": "glitter care",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1112",
            "repere": "Paragraphe · LHLA Glitter jars have a shelf life of…",
            "text": "LHLA Glitter jars have a shelf life of 18-24 months once opened but can last much longer if properly cared for.<br><br>• Keep plastic sealing disc inside (pro jars only) and do not leave jar open and exposed to air for long periods of time.<br>• Clean glass rim to keep it free from glitter build up as that may prevent jar from properly sealing.<br>• Mist or add a few drops of distilled water after every few uses.<br>• If glitter has lost it's adhesiveness due to drying out, add small amounts of distilled water and our Lemon.aid Mixing Medium to revive it.",
            "image": "",
            "link": ""
          }
        },
