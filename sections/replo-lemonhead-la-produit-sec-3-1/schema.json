        {
          "type": "element",
          "settings": {
            "slot": "s1089",
            "repere": "Paragraphe · SPACEPASTE® is the original luxury gli…",
            "text": "SPACEPASTE® is the original luxury glitter concentrate that changed the way makeup artists wear glitter.",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1090",
            "repere": "Paragraphe · Available in 27 iconic shades across i…",
            "text": "Available in 27 iconic shades across illuminating, metallic and holographic finishes, SPACEPASTE® delivers intense sparkle and color payoff in a single swipe. The ready-to-wear formula goes straight from the jar to the skin with no glitter glue, no mixing and virtually no fallout.",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1091",
            "repere": "Paragraphe · Handmade in Los Angeles and trusted by…",
            "text": "Handmade in Los Angeles and trusted by celebrity makeup artists, SPACEPASTE® has become an industry staple for editorial, runway, film, television and everyday makeup lovers who want maximum impact with minimal effort.",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1092",
            "repere": "Paragraphe · Unlike traditional glitter gels, SPACE…",
            "text": "Unlike traditional glitter gels, SPACEPASTE® is packed with cosmetic-grade glitter for rich, opaque coverage that feels lightweight and comfortable all day. Simply apply with your fingertips or a brush, then remove with your favorite makeup remover when you’re ready.",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "t1097_1",
            "repere": "Texte · additional details",
            "text": "additional details",
            "image": "",
            "link": ""
