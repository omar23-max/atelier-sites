<section
  class="atl-solution-image-icones"
  style="--atl-bg: {{ section.settings.color_bg }}; --atl-text: {{ section.settings.color_text }}; --atl-card: {{ section.settings.color_card }}; --atl-accent: {{ section.settings.color_accent }}; --atl-pt: {{ section.settings.padding_top }}px; --atl-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="atl-solution-image-icones__inner">
    <div class="atl-solution-image-icones__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1300 }}" alt="" loading="lazy">
      {%- else -%}
        <span>[ Visuel du mécanisme — illustration sur fond sombre ]</span>
      {%- endif -%}
    </div>
    <div class="atl-solution-image-icones__content">
      <p class="atl-solution-image-icones__kicker">{{ section.settings.kicker }}</p>
      <h2 class="atl-solution-image-icones__title">{{ section.settings.title }}</h2>
      <div class="atl-solution-image-icones__text">
        <p>{{ section.settings.text | strip | newline_to_br }}</p>
      </div>
      <div class="atl-solution-image-icones__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'atout' -%}
            <div class="atl-solution-image-icones__item" {{ block.shopify_attributes }}>
              <span class="atl-solution-image-icones__icon">
                {%- if block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 96 }}" alt="" loading="lazy">
                {%- else -%}
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="currentColor"/></svg>
                {%- endif -%}
              </span>
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
