{
  "name": "Atl · replo-vuori- 1",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Copie au design identique d'une page importée. Chaque bloc est un emplacement de la page : modifie son texte, son image ou son lien."
    },
    {
      "type": "header",
      "content": "Couleurs (suivent le design.md)"
    },
    {
      "type": "color",
      "id": "role_fond",
      "label": "Fond de page",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "role_surface",
      "label": "Surface (encadrés)",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "role_texte",
      "label": "Texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "role_accent",
      "label": "Accent (liens)",
      "default": "#727272"
    },
    {
      "type": "color",
      "id": "role_bouton",
      "label": "Bouton",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "role_bouton_texte",
      "label": "Texte des boutons",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Ordre des éléments"
    },
    {
      "type": "text",
      "id": "ordres",
      "label": "Ordre (réglé par l'atelier en déplaçant les éléments)"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "fond_section",
      "label": "Fond de la section (vide = d'origine)"
    },
    {
      "type": "text",
      "id": "marge_haut",
      "label": "Marge en haut, px (vide = d'origine)"
    },
    {
      "type": "text",
      "id": "marge_bas",
      "label": "Marge en bas, px (vide = d'origine)"
    },
    {
      "type": "select",
      "id": "largeur",
      "label": "Largeur du contenu",
      "options": [
        {
          "value": "",
          "label": "D'origine"
        },
        {
          "value": "large",
          "label": "Large (1200 px)"
        },
        {
          "value": "etroite",
          "label": "Étroite (760 px)"
        }
      ],
      "default": ""
    }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "element",
      "name": "Élément",
      "settings": [
        {
          "type": "text",
          "id": "repere",
          "label": "Repère"
        },
        {
          "type": "text",
          "id": "slot",
          "label": "Emplacement (ne pas modifier)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte (ou texte alternatif de l'image)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (boutons et liens)"
        },
        {
          "type": "text",
          "id": "style",
          "label": "Style de l'élément (réglé par l'atelier)"
        }
      ]
    }
  ],
