<div
  class="atl-annonce-fleches{% unless section.settings.show_arrows %} atl-annonce-fleches--sans-fleches{% endunless %}"
  style="--atl-bg: {{ section.settings.color_bg }}; --atl-text: {{ section.settings.color_text }};"
  data-autoplay="{{ section.settings.autoplay }}"
>
  <button
    class="atl-annonce-fleches__arrow"
    type="button"
    aria-label="Message précédent"
    onclick="var t=this.parentNode.querySelector('.atl-annonce-fleches__track');t.scrollLeft<=2?t.scrollTo({left:t.scrollWidth,behavior:'smooth'}):t.scrollBy({left:-t.clientWidth,behavior:'smooth'})"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
  </button>
  <div class="atl-annonce-fleches__track">
    {%- for block in section.blocks -%}
      <p class="atl-annonce-fleches__msg" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </p>
    {%- endfor -%}
  </div>
  <button
    class="atl-annonce-fleches__arrow"
    type="button"
    aria-label="Message suivant"
    onclick="var t=this.parentNode.querySelector('.atl-annonce-fleches__track');t.scrollLeft+t.clientWidth>=t.scrollWidth-2?t.scrollTo({left:0,behavior:'smooth'}):t.scrollBy({left:t.clientWidth,behavior:'smooth'})"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
  </button>
  <img
    alt=""
    hidden
    src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
    onload="var r=this.parentNode,s=+r.dataset.autoplay;if(s>0&&!r.dataset.on){r.dataset.on=1;setInterval(function(){r.querySelectorAll('button')[1].click()},s*1000)}"
  >
</div>
