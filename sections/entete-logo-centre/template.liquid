<div class="atl-entete-logo-centre" style="--atl-bg: {{ section.settings.color_bg }}; --atl-text: {{ section.settings.color_text }}; --atl-logo-w: {{ section.settings.logo_width }}px;">
  <div class="atl-entete-logo-centre__inner">
    <span></span>
    <a class="atl-entete-logo-centre__logo" href="{{ routes.root_url | default: '/' }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 500 }}" alt="{{ section.settings.logo_text | escape }}">
      {%- else -%}
        <span>♡ {{ section.settings.logo_text }}</span>
      {%- endif -%}
    </a>
    <div class="atl-entete-logo-centre__icons">
      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url | default: '/account' }}" aria-label="Mon compte">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url | default: '/cart' }}" aria-label="Panier">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8zm4 0V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
      </a>
    </div>
  </div>
</div>
