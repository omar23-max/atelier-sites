    {
      "name": "Avis d'expert · Avis clie",
      "blocks": [
        {
          "type": "element",
          "settings": {
            "slot": "s1312",
            "repere": "Paragraphe · \"K18 is known for its biology-first ap…",
            "text": "\"K18 is known for its biology-first approach. Everyone knows that we repair hair fiber. But we've actually been doing scalp research for several years now, and that research is finally getting into the consumer's hands so we can fight premature aging at the root.\"",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1314",
            "repere": "Paragraphe · DR. RACHAEL WILLIAMS",
            "text": "DR. RACHAEL WILLIAMS",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1317",
            "repere": "Paragraphe · senior scientist at K18 + expert in sc…",
            "text": "senior scientist at K18 + expert in scalp and hair follicle biology",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1326",
            "repere": "Paragraphe · \"As a board-certified dermatologist, I…",
            "text": "\"As a board-certified dermatologist, I'm always looking for products that are backed by science and address the underlying causes of hair concerns rather than simply masking them. FutureIQ™ stands out because it takes a scalp-first approach while leveraging K18's peptide technology to support long-term hair and scalp health. I've been impressed by its focus on creating an environment that supports healthier-looking, fuller hair over time, while still being lightweight enough for everyday use.\"",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1328",
            "repere": "Paragraphe · DR. MINA AMIN",
            "text": "DR. MINA AMIN",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1331",
            "repere": "Paragraphe · board certified medical & cosmetic der…",
            "text": "board certified medical & cosmetic dermatologist",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1340",
            "repere": "Paragraphe · \"Your scalp is skin. Full stop. It age…",
            "text": "\"Your scalp is skin. Full stop. It ages that same way, it responds to the same biological signals, and it has been completely ignored by the industry until now. FutureIQ™ brings the same preventative thinking to hair that we have always applied to the face. That is long overdue.\"",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1342",
            "repere": "Paragraphe · DR. VALI",
            "text": "DR. VALI",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1345",
            "repere": "Paragraphe · twice board-certified cosmetic dermato…",
            "text": "twice board-certified cosmetic dermatologist + medical wellness and longevity expert + K18 ambassador",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1354",
            "repere": "Paragraphe · \"As a dermatologist, I love that Futur…",
            "text": "\"As a dermatologist, I love that FutureIQ™ takes a longevity approach to hair by focusing on the scalp and hair follicle. It's designed to support healthier, fuller-looking hair while also addressing concerns like thinning, graying, and scalp aging.\"",
            "image": "",
            "link": ""
          }
        },
        {
          "type": "element",
          "settings": {
            "slot": "s1356",
            "repere": "Paragraphe · DR. SHEILA FARHANG",
